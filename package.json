{
  "name": "my-petition",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node -e \"require('node:fs').mkdirSync('dist',{recursive:true})\" && wrangler dev --port 8787 --local",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "db:local": "wrangler d1 migrations apply my-petition-db --local",
    "db:remote": "wrangler d1 migrations apply my-petition-db --remote",
    "deploy": "npm run build && wrangler deploy",
    "test:smoke": "node scripts/smoke-test.mjs",
    "release:prepare": "node scripts/prepare-production.mjs"
  },
  "dependencies": {
    "hono": "^4.10.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.46.0"
  }
}
